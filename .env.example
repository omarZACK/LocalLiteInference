# ----------------------------------------------------------------------
# Environment variables for the LiteLLM proxy container
# ----------------------------------------------------------------------
# Master key – required for all API calls.
# Replace the placeholder with a secure, random secret before deployment.
LITELLM_MASTER_KEY=sk-REPLACE_WITH_YOUR_MASTER_KEY

# Port on which the container will listen (maps to host 4000 by default)
LITELLM_PORT=4001

# ----------------------------------------------------------------------
# Host endpoints for fallback services (adjust to match your local setup)
# ----------------------------------------------------------------------
# Example vLLM endpoint – change the host/port if needed.
VLLM_HOST=http://localhost:8000

# Example Text Generation Inference (TGI) endpoint.
TGI_HOST=http://localhost:8080

# ----------------------------------------------------------------------
# Optional additional configuration
# ----------------------------------------------------------------------
# Set to "true" to enable detailed request/response logging.
LITELLM_DEBUG=false
